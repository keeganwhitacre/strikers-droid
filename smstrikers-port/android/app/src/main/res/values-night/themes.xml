<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Strikers.Setup" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launcher_surface</item>
        <item name="android:colorBackground">@color/launcher_surface</item>
        <item name="android:textColorPrimary">@color/launcher_on_surface</item>
        <item name="android:textColorSecondary">@color/launcher_on_surface_variant</item>
        <item name="android:colorAccent">@color/launcher_primary</item>
        <item name="android:statusBarColor">@color/launcher_surface</item>
        <item name="android:navigationBarColor">@color/launcher_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.Strikers.Settings" parent="@android:style/Theme.Material" />
    <!-- Settings over a running match: a floating window, the game dimmed behind it. A tap outside
         closes it, as Back and B do. -->
    <style name="Theme.Strikers.SettingsPopup" parent="@android:style/Theme.Material.Dialog">
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>
</resources>
